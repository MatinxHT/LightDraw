<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Mono WebAssembly requires separate PDB files for managed debugging. -->
    <DebugType>portable</DebugType>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
    <Version>0.7.4</Version>
    <Product>LightDraw</Product>
	<Authors>Martin Hung Chiho</Authors>
    <Copyright>Copyright © 2026 LightDraw contributors</Copyright>
  </PropertyGroup>
</Project>
