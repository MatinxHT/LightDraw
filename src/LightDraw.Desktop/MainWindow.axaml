<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:skia="using:LightDraw.Rendering.Skia"
		xmlns:vm="using:LightDraw.Desktop.ViewModels"
		x:Class="LightDraw.Desktop.MainWindow"
		x:DataType="vm:MainWindowViewModel"
		Title="光绘课堂 (LightDraw)"
		Width="1480"
		Height="800"
		MinWidth="920"
		MinHeight="600"
		Background="#0B1220">
  <Grid ColumnDefinitions="238,*" RowDefinitions="Auto,Auto,Auto,*,Auto">
	<Border Grid.ColumnSpan="2" Padding="18,12" Background="#111B2E" BorderBrush="#26344C" BorderThickness="0,0,0,1">
	  <Grid ColumnDefinitions="Auto,*,Auto">
		<StackPanel Orientation="Horizontal" Spacing="10">
		  <Border Width="34" Height="34" CornerRadius="8" Background="#194B68">
			<TextBlock Text="◈" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#7DE3FF" />
		  </Border>
		  <StackPanel>
			<TextBlock Text="光绘课堂 (LightDraw)" FontSize="18" FontWeight="SemiBold" />
			<TextBlock Text="几何光学教学与绘图" FontSize="11" Foreground="#91A4C2" />
		  </StackPanel>
		</StackPanel>
		<TextBlock Grid.Column="2" Text=".NET 10 · Avalonia · SkiaSharp" Foreground="#7F93B2" VerticalAlignment="Center" />
	  </Grid>
	</Border>

	<Border Grid.Row="1" Grid.ColumnSpan="2" Padding="18,10" Background="#0F1A2E" BorderBrush="#26344C" BorderThickness="0,0,0,1">
	  <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
		<StackPanel Orientation="Horizontal" Spacing="6">
		  <Button Classes="toolbar-inline" Classes.selected="{Binding ActiveTool, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Pan}" Content="✥ 平移界面" Command="{Binding SelectToolCommand}" CommandParameter="Pan" />
		  <Button Classes="toolbar-inline" Classes.selected="{Binding ActiveTool, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Move}" Content="✣ 移动/编辑" Command="{Binding SelectToolCommand}" CommandParameter="Move" />
		  <Button Classes="toolbar-inline" Classes.selected="{Binding ActiveTool, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Delete}" Content="× 删除" Command="{Binding SelectToolCommand}" CommandParameter="Delete" />
		</StackPanel>
		<Border Grid.Column="1" Width="1" Margin="14,4" Background="#26344C" />
		<TextBlock Grid.Column="2" Text="统一模拟配置" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
		<TextBlock Grid.Column="3" Text="每个光源的光线数量" Foreground="#7F93B2" FontSize="11" VerticalAlignment="Center" Margin="14,0" />
		<Grid Grid.Column="4" ColumnDefinitions="*,42" MinWidth="120" VerticalAlignment="Center">
		  <Slider Minimum="1" Maximum="1000" Value="{Binding RayDensity, Mode=TwoWay}" TickFrequency="1" SmallChange="10" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
		  <TextBlock Grid.Column="1" Text="{Binding RayDensity}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#7DE3FF" />
		</Grid>
		<Border Grid.Column="5" Width="1" Margin="14,4" Background="#26344C" />
		<StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6">
		  <Button Classes="toolbar-inline" Content="⌂ 重置场景" Command="{Binding ResetSceneCommand}" />
		  <Button Classes="toolbar-inline" Content="◎ 适合窗口" Command="{Binding ResetViewCommand}" />
		  <Button Classes="toolbar-inline" Content="打开场景…" Command="{Binding OpenSceneCommand}" />
		  <Button Classes="toolbar-inline" Content="保存场景…" Command="{Binding SaveSceneCommand}" />
		  <Button Classes="toolbar-inline" Content="关于程序" Command="{Binding ShowAboutCommand}" />
		</StackPanel>
	  </Grid>
	</Border>

	<Border Grid.Row="2" Grid.ColumnSpan="2" Padding="18,7" Background="#0D1728" BorderBrush="#26344C" BorderThickness="0,0,0,1">
	  <Grid RowDefinitions="Auto,Auto">
		<WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
		  <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,18,2" VerticalAlignment="Center">
			<TextBlock Text="几何关系" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
			<Border Width="1" Height="24" Margin="4,0" Background="#26344C" />
			<TextBlock Text="{Binding SelectedElementName}" MinWidth="105" Foreground="#7DE3FF" VerticalAlignment="Center" />
		  </StackPanel>
		  <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,2,18,2" VerticalAlignment="Center" IsEnabled="{Binding HasSelectedElement}">
			<TextBlock Text="第一原点" Foreground="#9EB0CA" VerticalAlignment="Center" ToolTip.Tip="元件原点；凹球面镜上圆弧的中点" />
			<TextBlock Text="X" Foreground="#7F93B2" VerticalAlignment="Center" />
			<TextBox Width="66" HorizontalContentAlignment="Right" Text="{Binding SelectedOriginX, Mode=TwoWay}" />
			<TextBlock Text="Y" Foreground="#7F93B2" VerticalAlignment="Center" />
			<TextBox Width="66" HorizontalContentAlignment="Right" Text="{Binding SelectedOriginY, Mode=TwoWay}" />
			<TextBlock Text="mm" Foreground="#7F93B2" VerticalAlignment="Center" />
		  </StackPanel>
		  <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,2,18,2" VerticalAlignment="Center" IsEnabled="{Binding HasSelectedSecondOrigin}">
			<TextBlock Text="第二原点" Foreground="#9EB0CA" VerticalAlignment="Center" ToolTip.Tip="凹球面镜的球心坐标" />
			<TextBlock Text="X" Foreground="#7F93B2" VerticalAlignment="Center" />
			<TextBox Width="66" HorizontalContentAlignment="Right" Text="{Binding SelectedSecondOriginX, Mode=TwoWay}" />
			<TextBlock Text="Y" Foreground="#7F93B2" VerticalAlignment="Center" />
			<TextBox Width="66" HorizontalContentAlignment="Right" Text="{Binding SelectedSecondOriginY, Mode=TwoWay}" />
			<TextBlock Text="mm" Foreground="#7F93B2" VerticalAlignment="Center" />
		  </StackPanel>
		  <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2" VerticalAlignment="Center" IsEnabled="{Binding CanRotateSelectedElement}">
			<TextBlock Text="旋转步进" Foreground="#9EB0CA" VerticalAlignment="Center" />
			<TextBox Width="58" HorizontalContentAlignment="Right" Text="{Binding RotationStep, Mode=TwoWay}" />
			<TextBlock Text="°" Foreground="#7F93B2" VerticalAlignment="Center" />
			<Button Classes="setting-inline" Content="↶ 逆时针" Command="{Binding RotateSelectedCommand}" CommandParameter="Counterclockwise" />
			<Button Classes="setting-inline" Content="↷ 顺时针" Command="{Binding RotateSelectedCommand}" CommandParameter="Clockwise" />
			<TextBlock Text="{Binding SelectedAngleText}" MinWidth="98" Foreground="#9EB0CA" VerticalAlignment="Center" Margin="2,0" />
			<ComboBox Width="100" SelectedIndex="{Binding SelectedStandardAngleIndex, Mode=TwoWay}">
			  <ComboBoxItem Content="自定义" IsEnabled="False" />
			  <ComboBoxItem Content="0°" />
			  <ComboBoxItem Content="90°" />
			  <ComboBoxItem Content="180°" />
			  <ComboBoxItem Content="270°" />
			</ComboBox>
		  </StackPanel>
		</WrapPanel>
		<Border Grid.Row="1" Margin="0,5,0,0" Padding="0,5,0,0" BorderBrush="#26344C" BorderThickness="0,1,0,0">
		  <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
			<TextBlock Text="元件参数" FontSize="13" FontWeight="SemiBold" MinWidth="92" Margin="0,2,18,2" VerticalAlignment="Center" />
			<StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,18,2" VerticalAlignment="Center" IsEnabled="{Binding HasSelectedLength}">
			  <TextBlock Text="长度" Foreground="#9EB0CA" VerticalAlignment="Center" ToolTip.Tip="元件原点到任一端点的距离 × 2" />
			  <TextBox Width="68" HorizontalContentAlignment="Right" Text="{Binding SelectedLength, Mode=TwoWay}" />
			  <TextBlock Text="mm" Foreground="#7F93B2" VerticalAlignment="Center" />
			</StackPanel>
			<StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,18,2" VerticalAlignment="Center" IsEnabled="{Binding HasSelectedLightSource}">
			  <TextBlock Text="波长" Foreground="#9EB0CA" VerticalAlignment="Center" ToolTip.Tip="光源波长；用于计算光栅衍射角" />
			  <TextBox Width="68" HorizontalContentAlignment="Right" Text="{Binding SelectedWavelength, Mode=TwoWay}" />
			  <TextBlock Text="nm" Foreground="#7F93B2" VerticalAlignment="Center" />
			</StackPanel>
			<StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,18,2" VerticalAlignment="Center" IsEnabled="{Binding HasSelectedAperture}">
			  <TextBlock Text="通孔" Foreground="#9EB0CA" VerticalAlignment="Center" ToolTip.Tip="光阑中央允许光线通过的开口大小" />
			  <TextBox Width="68" HorizontalContentAlignment="Right" Text="{Binding SelectedApertureOpening, Mode=TwoWay}" />
			  <TextBlock Text="mm" Foreground="#7F93B2" VerticalAlignment="Center" />
			</StackPanel>
			<StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,18,2" VerticalAlignment="Center" IsEnabled="{Binding HasSelectedLens}">
			  <TextBlock Text="焦距" Foreground="#9EB0CA" VerticalAlignment="Center" ToolTip.Tip="球面镜焦距始终等于半径的一半" />
			  <TextBox Width="68" HorizontalContentAlignment="Right" Text="{Binding SelectedFocalLength, Mode=TwoWay}" />
			  <TextBlock Text="mm" Foreground="#7F93B2" VerticalAlignment="Center" />
			</StackPanel>
			<StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,18,2" VerticalAlignment="Center" IsEnabled="{Binding HasSelectedSphericalMirror}">
			  <TextBlock Text="半径" Foreground="#9EB0CA" VerticalAlignment="Center" ToolTip.Tip="曲率半径；修改后焦距自动更新为 R/2" />
			  <TextBox Width="68" HorizontalContentAlignment="Right" Text="{Binding SelectedSphericalMirrorRadius, Mode=TwoWay}" />
			  <TextBlock Text="mm" Foreground="#7F93B2" VerticalAlignment="Center" />
			</StackPanel>
			<StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,18,2" VerticalAlignment="Center" IsEnabled="{Binding HasSelectedSphericalMirror}">
			  <TextBlock Text="圆心角" Foreground="#9EB0CA" VerticalAlignment="Center" ToolTip.Tip="决定镜面圆弧大小；默认 180°" />
			  <TextBox Width="68" HorizontalContentAlignment="Right" Text="{Binding SelectedSphericalMirrorArcAngle, Mode=TwoWay}" />
			  <TextBlock Text="°" Foreground="#7F93B2" VerticalAlignment="Center" />
			</StackPanel>
			<StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,2" VerticalAlignment="Center" IsEnabled="{Binding HasSelectedReflectionGrating}">
			  <TextBlock Text="刻线密度" Foreground="#9EB0CA" VerticalAlignment="Center" ToolTip.Tip="反射光栅每毫米的刻线数量" />
			  <TextBox Width="78" HorizontalContentAlignment="Right" Text="{Binding SelectedGrooveDensity, Mode=TwoWay}" />
			  <TextBlock Text="线/mm" Foreground="#7F93B2" VerticalAlignment="Center" />
			</StackPanel>
		  </WrapPanel>
		</Border>
	  </Grid>
	</Border>

	<Border Grid.Row="3" Background="#10192A" BorderBrush="#26344C" BorderThickness="0,0,1,0">
	  <Grid RowDefinitions="Auto,*">
		<TextBlock Text="创建工具" FontSize="14" FontWeight="SemiBold" Margin="18,16,0,14" />
		<ScrollViewer Grid.Row="1" Padding="16,0,16,16" VerticalScrollBarVisibility="Auto">
		  <StackPanel Spacing="2">
			<TextBlock Text="光源类" Foreground="#7F93B2" FontSize="11" Margin="3,8,0,2" />
			<Button Classes="toolbar" Classes.selected="{Binding ActiveTool, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=PointLight}" Content="● 点光源" Command="{Binding SelectToolCommand}" CommandParameter="PointLight" />
			<Button Classes="toolbar" Classes.selected="{Binding ActiveTool, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=ParallelLight}" Content="▥ 线平行光源" Command="{Binding SelectToolCommand}" CommandParameter="ParallelLight" />
			<TextBlock Text="透镜类" Foreground="#7F93B2" FontSize="11" Margin="3,12,0,2" />
			<Button Classes="toolbar" Classes.selected="{Binding ActiveTool, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=ConvexLens}" Content="◉ 凸透镜" Command="{Binding SelectToolCommand}" CommandParameter="ConvexLens" />
			<Button Classes="toolbar" Classes.selected="{Binding ActiveTool, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=ConcaveLens}" Content=")( 凹透镜" Command="{Binding SelectToolCommand}" CommandParameter="ConcaveLens" />
			<Button Classes="toolbar" Classes.selected="{Binding ActiveTool, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Aperture}" Content="┃ ┃ 光阑" Command="{Binding SelectToolCommand}" CommandParameter="Aperture" />
			<TextBlock Text="反射镜类" Foreground="#7F93B2" FontSize="11" Margin="3,12,0,2" />
			<Button Classes="toolbar" Classes.selected="{Binding ActiveTool, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Mirror}" Content="／ 平面反光镜" Command="{Binding SelectToolCommand}" CommandParameter="Mirror" />
			<Button Classes="toolbar" Classes.selected="{Binding ActiveTool, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=ConcaveSphericalMirror}" Content="◖ 理想凹球面镜" Command="{Binding SelectToolCommand}" CommandParameter="ConcaveSphericalMirror" ToolTip.Tip="第一次点击镜面中心点，第二次点击曲率圆心；默认圆心角 180°" />
			<Button Classes="toolbar" Classes.selected="{Binding ActiveTool, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=ConvexSphericalMirror}" Content="◗ 理想凸球面镜" Command="{Binding SelectToolCommand}" CommandParameter="ConvexSphericalMirror" ToolTip.Tip="第一次点击镜面中心点，第二次点击曲率圆心；默认圆心角 180°" />
			<Button Classes="toolbar" Classes.selected="{Binding ActiveTool, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=BeamSplitter}" Content="／ 平面分光镜" Command="{Binding SelectToolCommand}" CommandParameter="BeamSplitter" ToolTip.Tip="透射与反射光强各为入射光的 50%" />
			<Button Classes="toolbar" Classes.selected="{Binding ActiveTool, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=ReflectionGrating}" Content="≋ 反射光栅" Command="{Binding SelectToolCommand}" CommandParameter="ReflectionGrating" ToolTip.Tip="衍射强度：0级 7/8，正负1级各 6/8，之后每级递减 1/8" />
			<Button Classes="toolbar" Classes.selected="{Binding ActiveTool, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Screen}" Content="┃ 光屏" Command="{Binding SelectToolCommand}" CommandParameter="Screen" ToolTip.Tip="命中光屏后立即截停光线" />

			<Separator Margin="0,16,0,14" />
			<TextBlock Text="移动主体：整体平移&#x0a;一般端点：拉伸并旋转&#x0a;球面镜第二原点：只旋转&#x0a;删除元件：单击后自动返回" Foreground="#7F93B2" FontSize="12" LineHeight="19" Margin="3,0,0,0" />
		  </StackPanel>
		</ScrollViewer>
	  </Grid>
	</Border>

	<skia:OpticalCanvas x:Name="Canvas"
						Grid.Row="3"
						Grid.Column="1"
						Scene="{Binding CurrentScene, Mode=TwoWay}"
						RaysPerSource="{Binding AppliedRaysPerSource}"
						ActiveTool="{Binding ActiveTool, Mode=TwoWay}" />

	<Border Grid.Row="4" Grid.ColumnSpan="2" Background="#111B2E" BorderBrush="#26344C" BorderThickness="0,1,0,0" Padding="14,7">
	  <Grid ColumnDefinitions="*,Auto">
		<TextBlock Text="{Binding StatusText}" Foreground="#9EB0CA" FontSize="12" />
		<TextBlock Grid.Column="1" Text="PolyForm Noncommercial 1.0.0 · 仅限非商业使用" Foreground="#687D9D" FontSize="12" />
	  </Grid>
	</Border>
  </Grid>
</Window>
