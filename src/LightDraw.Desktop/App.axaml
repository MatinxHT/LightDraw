<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:LightDraw.Desktop.Converters"
             x:Class="LightDraw.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <conv:EnumEqualsConverter x:Key="EnumEqualsConverter" />
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Button.toolbar">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.toolbar.selected">
      <Setter Property="Background" Value="#1F6FEB33" />
      <Setter Property="BorderBrush" Value="#7DE3FF" />
      <Setter Property="Foreground" Value="#7DE3FF" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.toolbar-inline">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#26344C" />
    </Style>
  </Application.Styles>
</Application>
