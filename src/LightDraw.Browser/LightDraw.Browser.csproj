<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-browser</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <WasmEnableThreads>false</WasmEnableThreads>
    <WasmBuildNative>true</WasmBuildNative>
    <!-- The SDK can reuse a compressed dotnet.js with stale WASM fingerprints on incremental builds. -->
    <DisableBuildCompression Condition="'$(Configuration)' == 'Debug'">true</DisableBuildCompression>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../LightDraw.Core/LightDraw.Core.csproj" />
    <ProjectReference Include="../LightDraw.Rendering.Skia/LightDraw.Rendering.Skia.csproj" />
    <PackageReference Include="Avalonia.Browser" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" />
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../LightDraw.Desktop/Controls/*.axaml.cs" Link="Controls/%(Filename)%(Extension)" />
    <AvaloniaXaml Include="../LightDraw.Desktop/Controls/*.axaml" Link="Controls/%(Filename)%(Extension)" />
    <Compile Include="../LightDraw.Desktop/Services/DocumentViewBinding.cs" Link="Services/DocumentViewBinding.cs" />
    <Compile Include="../LightDraw.Desktop/ViewModels/SceneDocumentViewModel.cs" Link="ViewModels/SceneDocumentViewModel.cs" />
    <Compile Include="../LightDraw.Desktop/ViewModels/MainWindowViewModel.cs" Link="ViewModels/MainWindowViewModel.cs" />
    <Compile Include="../LightDraw.Desktop/ViewModels/ElectrostaticWindowViewModel.cs" Link="ViewModels/ElectrostaticWindowViewModel.cs" />
    <Compile Include="../LightDraw.Desktop/ViewModels/MagnetostaticWindowViewModel.cs" Link="ViewModels/MagnetostaticWindowViewModel.cs" />
    <Compile Include="../LightDraw.Desktop/Services/ISceneStorageService.cs" Link="Services/ISceneStorageService.cs" />
    <Compile Include="../LightDraw.Desktop/Services/LocalizationService.cs" Link="Services/LocalizationService.cs" />
    <Compile Include="../LightDraw.Desktop/Converters/EnumEqualsConverter.cs" Link="Converters/EnumEqualsConverter.cs" />
    <AvaloniaResource Include="../LightDraw.Desktop/Themes/Palette.axaml" Link="Themes/Palette.axaml" />
    <AvaloniaResource Include="../LightDraw.Desktop/Assets/Brand/LightDrawLogo.png" Link="Assets/Brand/LightDrawLogo.png" />
    <AvaloniaResource Include="Assets/Fonts/NotoSansCJKsc-Regular.otf" />
  </ItemGroup>
  <Target Name="CleanPublishedWwwroot" BeforeTargets="PrepareForPublish"
          Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)wwwroot')">
    <RemoveDir Directories="$(PublishDir)wwwroot" />
  </Target>
  <!-- Avalonia.Browser 12.1 also adds 3.1.56 archives. Use the 6.0.2 archives selected by the native packages. -->
  <Target Name="RemoveLegacyAvaloniaWasmArchives"
          BeforeTargets="_PrepareForBrowserWasmBuildNative;_CoreCLRPrepareForNativeBuild">
    <ItemGroup>
      <NativeFileReference Remove="$(SkiaSharpStaticLibraryPath)/3.1.56/**/*.a" />
      <NativeFileReference Remove="$(HarfBuzzSharpStaticLibraryPath)/3.1.56/**/*.a" />
    </ItemGroup>
  </Target>
</Project>
