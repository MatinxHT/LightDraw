<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <SkiaSharpVersion>4.156.1</SkiaSharpVersion>
    <HarfBuzzSharpVersion>14.4.0.101</HarfBuzzSharpVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Browser" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="HarfBuzzSharp" Version="$(HarfBuzzSharpVersion)" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.Linux" Version="$(HarfBuzzSharpVersion)" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.WebAssembly" Version="$(HarfBuzzSharpVersion)" />
    <PackageVersion Include="SkiaSharp" Version="$(SkiaSharpVersion)" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="$(SkiaSharpVersion)" />
    <PackageVersion Include="SkiaSharp.NativeAssets.WebAssembly" Version="$(SkiaSharpVersion)" />
  </ItemGroup>
</Project>
