{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug LightDraw Desktop",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build LightDraw Desktop",
      "program": "${workspaceFolder}/src/LightDraw.Desktop/bin/Debug/net10.0/LightDraw.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/LightDraw.Desktop",
      "stopAtEntry": false
    },
    {
      "name": "Debug LightDraw Browser",
      "type": "blazorwasm",
      "request": "attach",
      "browser": "chrome",
      "projectPath": "${workspaceFolder}/src/LightDraw.Browser/LightDraw.Browser.csproj",
      "cwd": "${workspaceFolder}/src/LightDraw.Browser",
      "url": "http://127.0.0.1:8765/",
      "preLaunchTask": "run LightDraw Browser",
      "postDebugTask": "stop LightDraw Browser"
    }
  ]
}
