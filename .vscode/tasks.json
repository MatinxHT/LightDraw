{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build LightDraw Desktop",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/LightDraw.Desktop/LightDraw.Desktop.csproj",
        "--configuration",
        "Debug"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build LightDraw Browser",
      "type": "process",
      "command": "${workspaceFolder}/.vscode/dotnet-browser.sh",
      "windows": {
        "command": "dotnet"
      },
      "args": [
        "build",
        "${workspaceFolder}/src/LightDraw.Browser/LightDraw.Browser.csproj",
        "--configuration",
        "Debug"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "prepare LightDraw Browser",
      "type": "process",
      "dependsOn": [
        "build LightDraw Browser"
      ],
      "dependsOrder": "sequence",
      "command": "${workspaceFolder}/.vscode/dotnet-browser.sh",
      "windows": {
        "command": "dotnet"
      },
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/src/LightDraw.Browser/LightDraw.Browser.csproj",
        "--no-build",
        "--configuration",
        "Debug",
        "--launch-profile",
        "LightDraw.Browser"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "browser",
        "pattern": {
          "regexp": "^(?!)"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^WasmAppHost\\b",
          "endsPattern": "^Debug at url: http://127\\.0\\.0\\.1:8765/_framework/debug\\s*$"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "stop LightDraw Browser",
      "type": "process",
      "command": "${workspaceFolder}/.vscode/stop-browser.sh",
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/.vscode/stop-browser.ps1"
        ]
      },
      "problemMatcher": []
    }
  ]
}
